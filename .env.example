# ──────────────────────────────────────────────────────────────────────────────
# BB Copiloto MEI — Variáveis de Ambiente
# Copie para .env: cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── BFF FastAPI ───────────────────────────────────────────────────────────────

# Porta onde o BFF FastAPI será servido
BFF_PORT=8000

# ── Integração BrasilAPI ──────────────────────────────────────────────────────
#
# Controla o modo de operação da validação de CPF/CNPJ e antifraude de boletos.
#
# "mock" (padrão):
#   Retorna respostas determinísticas sem chamadas de rede externas.
#   Use para desenvolvimento local, testes unitários e CI/CD.
#
# "real":
#   Chama https://brasilapi.com.br/api/cnpj/v1/{cnpj} em tempo real.
#   Use para staging e produção com conectividade com a internet.
#
BRASIL_API_MODE=mock

# ── Logging ───────────────────────────────────────────────────────────────────

# Nível de log do servidor uvicorn/FastAPI (debug | info | warning | error)
LOG_LEVEL=info

# ── Servidor MCP TypeScript ───────────────────────────────────────────────────

# Binário Python a ser usado pelo servidor MCP para invocar o bridge CLI.
# Em sistemas onde 'python3' não está no PATH, especifique o caminho completo.
PYTHON_BIN=python3

# ── Google Gemini (Prioridade 1 — contingência autorizada pela mentoria IBM) ──
# Obtenha em: https://aistudio.google.com/apikey (plano gratuito disponível)
# GEMINI_API_KEY=<sua-gemini-api-key>
# GOOGLE_API_KEY=<alternativa — mesmo valor>

# ── IBM watsonx.ai (Prioridade 2 — retomada automática quando disponível) ─────
# Configure ao integrar com watsonx.ai e watsonx Orchestrate.
# WATSONX_API_KEY=<sua-api-key>
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=<seu-project-id>
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
